{
  "productName": "Steam MCP",
  "version": "0.3.1",
  "identifier": "ai.fleet.steam-mcp",
    "build": {
        "frontendDist": "../webapp/dist",
        "devUrl": "http://localhost:11021",
        "beforeDevCommand": "npm --prefix ../webapp run dev",
        "beforeBuildCommand": "pwsh -NoProfile -Command \"$env:VITE_API_BASE='http://127.0.0.1:11020'; npm --prefix ../webapp run build\""
    },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Steam MCP",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:11020 ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/steam-mcp-backend.exe",
            "resources/.env.example"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
}
    }
  },
  "plugins": {
    "shell": { "open": true },
    "fs": { "requireLiteralLeadingDot": false },
    "process": { "all": true }
  }
}



